{
  "name": "mailer-test",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  // Public workers.dev URL so you can open the test page in a browser.
  // (Only this test page is public — the mailer itself is internal-only.)
  "workers_dev": true,
  // The mailer worker must be deployed first, or this deploy fails
  // binding validation.
  "services": [
    {
      "binding": "MAILER",
      "service": "mailer"
    }
  ],
  "observability": {
    "enabled": true
  }
}
